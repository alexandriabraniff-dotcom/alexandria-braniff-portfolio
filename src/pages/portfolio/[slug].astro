---
// Case study page, one per project in src/data/projects.json.
// Gallery images are exported from the Figma file
// "Alexandria Braniff Portfolio – Case Study Boards" into
// public/images/projects/<id>/{desktop,mobile,pages,before-*}.webp (2400x1500).
import Layout from '../../layouts/Layout.astro';
import AnimateIn from '../../components/AnimateIn.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import allProjects from '../../data/projects.json';

export const prerender = true;

type Img = { src: string; alt: string };
type Project = (typeof allProjects)[number] & {
  client?: string; location?: string; year?: string; type?: string; scope?: string;
  stack?: string[]; gallery?: Img[]; before?: Img[]; eventSite?: boolean; eventNote?: string; boardBg?: string;
};

const isCaseStudy = (p: Project) => !p.comingSoon && p.category !== 'logo-brand' && !!p.detail && !!p.gallery;

export function getStaticPaths() {
  return (allProjects as Project[])
    .filter((p) => !p.comingSoon && p.category !== 'logo-brand' && p.detail && p.gallery)
    .map((p) => ({ params: { slug: p.id } }));
}

const caseStudies = (allProjects as Project[]).filter(isCaseStudy);
const { slug } = Astro.params;
const project = caseStudies.find((p) => p.id === slug)!;
const isMockup = project.category === 'mockup';

// Other projects: the rest of this group starting from the next one (wrapping
// round), then the other group (client sites vs concepts).
const group = caseStudies.filter((p) => (p.category === 'mockup') === isMockup);
const at = group.indexOf(project);
const others = [
  ...group.slice(at + 1), ...group.slice(0, at),
  ...caseStudies.filter((p) => (p.category === 'mockup') !== isMockup),
];

const domain = project.url ? new URL(project.url).hostname.replace(/^www\./, '') : null;
const gallery = project.gallery!;
const before = project.before ?? [];
const [lead, ...rest] = gallery;
// Lightbox order: lead, before/after pairs, then the rest.
const pairs = before.map((b, i) => ({ before: b, after: gallery[i] }));
const lightbox: Img[] = before.length
  ? [...pairs.flatMap((p) => [p.before, p.after]), ...gallery.slice(before.length)]
  : gallery;
const lbIndex = (src: string) => lightbox.findIndex((i) => i.src === src);
const bandStyle = `--band:${project.boardBg ?? '#EDECEA'}`;

const facts = [
  { label: 'Client', value: project.client ?? project.name },
  { label: 'Services', value: project.scope },
  { label: 'Location', value: project.location },
  { label: 'Year', value: project.year },
  { label: 'Built with', value: project.stack?.join(', ') },
].filter((f) => f.value);
const story = [
  { label: 'The brief', text: project.detail!.business },
  { label: 'What I built', text: project.detail!.built },
  { label: 'The details', text: project.detail!.notable },
];
---

<Layout
  title={`${project.name} – Case Study | Alexandria Braniff`}
  description={`${project.blurb} A website case study by Alexandria Braniff, web designer and developer in Vancouver, BC.`}
  image={lead.src}
>
  <article class="light-layout">

    <!-- HEADER -->
    <header class="px-6 lg:px-12 pt-6 lg:pt-8 pb-8">
      <div class="max-w-7xl mx-auto">
        <a href={isMockup ? '/portfolio/mockup-projects' : '/portfolio'} class="inline-flex items-center min-h-[45px] font-body text-[11px] tracking-[0.14em] uppercase text-muted hover:text-text transition-colors duration-200">
          All projects
        </a>
        <div class="grid lg:grid-cols-[1.3fr_1fr] gap-6 lg:gap-14 items-end mt-3">
          <AnimateIn>
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-muted mb-3">{project.type}{project.location ? ` · ${project.location}` : ''}</p>
            <h1 class="font-serif text-text leading-[0.95]" style="font-size: clamp(2.25rem, 4.5vw, 4rem); font-style: italic; font-weight: 300;">{project.name}</h1>
          </AnimateIn>
          <AnimateIn delay={100}>
            <p class="font-body text-sm lg:text-[1rem] text-muted leading-relaxed mb-5">{project.blurb}</p>
            <div class="flex flex-col sm:flex-row gap-3">
              {project.url && (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center font-body font-semibold text-sm bg-text text-[#F7F6F2] px-6 py-3 min-h-[45px] hover:bg-muted transition-colors duration-200">
                  Visit the live site<span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
              <a href="#gallery" class={`inline-flex items-center justify-center font-body font-semibold text-sm px-6 py-3 min-h-[45px] transition-colors duration-200 ${project.url ? 'text-text border border-surface2 hover:border-text' : 'bg-text text-[#F7F6F2] hover:bg-muted'}`}>
                {before.length ? 'See the before and after' : 'See the images'}
              </a>
            </div>
          </AnimateIn>
        </div>

        {project.eventNote && (
          <div class="mt-6 px-4 py-3 max-w-3xl bg-surface border-l-2 border-text">
            <p class="font-body text-[11px] font-semibold mb-1 tracking-[0.14em] uppercase text-text">Event website</p>
            <p class="font-body text-sm text-muted leading-relaxed">{project.eventNote}</p>
          </div>
        )}

        {isMockup && (
          <div class="mt-6 px-4 py-3 max-w-3xl" style="background: #FEF2F2; border: 1px solid #FECACA;">
            <p class="font-body text-xs font-semibold mb-0.5 tracking-[0.1em] uppercase" style="color: #991B1B;">Concept project</p>
            <p class="font-body text-sm" style="color: #991B1B;">This is not an official {project.name} website. I designed and built it as my own concept to show what their site could look like. It has not been purchased or used by the business.</p>
          </div>
        )}
      </div>
    </header>

    <!-- LEAD IMAGE: full-width band in the board colour, image as large as the screen allows -->
    <div class="band" style={bandStyle}>
      <button type="button" class="gallery-open fit-screen" data-index={lbIndex(lead.src)} aria-label={`Enlarge image: ${lead.alt}`}>
        <img src={lead.src} alt={lead.alt} width="2400" height="1577" fetchpriority="high" />
      </button>
    </div>

    <!-- STORY + PROJECT DETAILS -->
    <section class="px-6 lg:px-12 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-[1.7fr_1fr] gap-10 lg:gap-16 items-start">
        <div class="space-y-8 lg:space-y-10">
          {story.map((s, i) => (
            <AnimateIn>
              <h2 class="font-body text-[10px] font-semibold tracking-[0.2em] uppercase text-coral-dark mb-3">{s.label}</h2>
              <p class={i === 0 ? 'font-serif text-text leading-snug' : 'font-body text-muted leading-relaxed text-sm lg:text-[1rem]'} style={i === 0 ? 'font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 400;' : ''}>{s.text}</p>
            </AnimateIn>
          ))}
        </div>

        <AnimateIn delay={100}>
          <aside class="bg-white p-6 lg:p-7 lg:sticky" style="border: 1px solid #E8E6E0; top: calc(var(--hdr, 4.5rem) + 1.5rem);" aria-labelledby="facts-title">
            <h2 id="facts-title" class="font-body text-[10px] font-semibold tracking-[0.2em] uppercase text-text mb-4">Project details</h2>
            <dl class="divide-y divide-surface2">
              {facts.map((f) => (
                <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3">
                  <dt class="font-body text-[10px] tracking-[0.18em] uppercase text-muted pt-1">{f.label}</dt>
                  <dd class="font-body text-sm text-text leading-relaxed">{f.value}</dd>
                </div>
              ))}
              <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3">
                <dt class="font-body text-[10px] tracking-[0.18em] uppercase text-muted pt-1">Website</dt>
                <dd class="font-body text-sm text-text leading-relaxed">
                  {domain ? (
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-surface2 hover:decoration-text break-all">{domain}<span class="sr-only"> (opens in a new tab)</span></a>
                  ) : project.eventSite ? 'Online for the festival only' : 'Not public'}
                </dd>
              </div>
            </dl>
            {project.url && (
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="mt-5 w-full inline-flex items-center justify-center font-body font-semibold text-sm bg-text text-[#F7F6F2] px-6 py-3 min-h-[45px] hover:bg-muted transition-colors duration-200">
                Visit the live site<span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </aside>
        </AnimateIn>
      </div>
    </section>

    <!-- BEFORE AND AFTER (redesigns only) -->
    {before.length > 0 && (
      <section id="gallery" class="scroll-mt-24 pb-10" aria-labelledby="ba-title">
        <div class="px-6 lg:px-12 max-w-7xl mx-auto mb-5">
          <h2 id="ba-title" class="font-serif text-text mb-1" style="font-size: clamp(1.6rem, 2.8vw, 2.4rem); font-style: italic; font-weight: 300;">Before and after</h2>
          <p class="font-body text-sm text-muted max-w-2xl">The previous website on the left, the redesign on the right. Select any image to see it larger.</p>
        </div>
        {pairs.map((pair) => (
          <div class="band band-pair" style={bandStyle}>
            {[['Before', pair.before], ['After', pair.after]].map(([label, img]) => (
              <figure class="pair-item">
                <figcaption class="pair-label">{label}</figcaption>
                <button type="button" class="gallery-open" data-index={lbIndex((img as Img).src)} aria-label={`Enlarge image: ${(img as Img).alt}`}>
                  <img src={(img as Img).src} alt={(img as Img).alt} width="2400" height="1577" loading="lazy" />
                </button>
              </figure>
            ))}
          </div>
        ))}
      </section>
    )}

    <!-- GALLERY -->
    <section id={before.length ? 'more' : 'gallery'} class="pb-12 lg:pb-16 scroll-mt-24" aria-labelledby="gallery-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <h2 id="gallery-title" class="font-serif text-text mb-6" style="font-size: clamp(1.6rem, 2.8vw, 2.4rem); font-style: italic; font-weight: 300;">{before.length ? 'More of the redesign' : 'A closer look'}</h2>
      </div>
      {(before.length ? gallery.slice(before.length) : rest).map((img) => (
        <div class="band" style={bandStyle}>
          <button type="button" class="gallery-open fit-screen" data-index={lbIndex(img.src)} aria-label={`Enlarge image: ${img.alt}`}>
            <img src={img.src} alt={img.alt} width="2400" height="1577" loading="lazy" />
          </button>
        </div>
      ))}
      {project.url && (
        <div class="max-w-7xl mx-auto px-6 lg:px-12 mt-10"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 border-t border-surface2 pt-8">
          <p class="font-serif text-text" style="font-size: clamp(1.3rem, 2.2vw, 1.9rem); font-style: italic; font-weight: 300;">Want to see it in action?</p>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center font-body font-semibold text-sm bg-text text-[#F7F6F2] px-6 py-3 min-h-[45px] hover:bg-muted transition-colors duration-200">
            Visit {domain}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div></div>
      )}
    </section>

    <!-- OTHER PROJECTS: same cards as the Projects page, in a row people can page through -->
    <section class="border-t border-surface2 py-12 lg:py-16 bg-surface" aria-labelledby="others-title">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 id="others-title" class="font-serif text-text" style="font-size: clamp(1.8rem, 3.5vw, 3rem); font-style: italic; font-weight: 300;">Other projects</h2>
          <div class="flex gap-2">
            <button type="button" id="others-prev" class="others-btn" aria-controls="others-track">Previous</button>
            <button type="button" id="others-next" class="others-btn" aria-controls="others-track">Next</button>
          </div>
        </div>
        <ul id="others-track" class="others-track" aria-label="Other projects">
          {others.map((p) => (
            <li class="others-item"><ProjectCard project={p} /></li>
          ))}
        </ul>
        <p id="others-status" class="font-body text-xs text-muted mt-4" aria-live="polite"></p>
      </div>
    </section>
  </article>

  <!-- LIGHTBOX -->
  <dialog id="lightbox" class="lightbox" aria-label={`${project.name} images`}>
    <div class="lightbox-inner">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption" class="font-body text-sm text-[#F7F6F2]/80 mt-3 text-center"></p>
      <div class="lightbox-controls">
        <button type="button" id="lb-prev" class="lb-btn">Previous</button>
        <button type="button" id="lb-close" class="lb-btn">Close</button>
        <button type="button" id="lb-next" class="lb-btn">Next</button>
      </div>
    </div>
  </dialog>
</Layout>

<script define:vars={{ images: lightbox }}>
  window.__GALLERY__ = images;
</script>

<script>
  const setHdr = () => {
    const h = document.getElementById('site-header')?.offsetHeight;
    if (h) document.documentElement.style.setProperty('--hdr', `${h}px`);
  };
  setHdr();
  window.addEventListener('resize', setHdr);

  const images = (window as any).__GALLERY__ as { src: string; alt: string }[];
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const cap = document.getElementById('lightbox-caption')!;
  let current = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    current = (i + images.length) % images.length;
    img.src = images[current].src;
    img.alt = images[current].alt;
    cap.textContent = `${images[current].alt} (${current + 1} of ${images.length})`;
  }
  document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((b) =>
    b.addEventListener('click', () => {
      opener = b;
      show(Number(b.dataset.index));
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  document.getElementById('lb-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(current + 1));
  document.getElementById('lb-close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  dlg.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    opener?.focus();
  });

  // Other projects row: Previous / Next move one card at a time.
  const track = document.getElementById('others-track');
  const prevBtn = document.getElementById('others-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('others-next') as HTMLButtonElement | null;
  const status = document.getElementById('others-status');
  if (track && prevBtn && nextBtn) {
    const items = Array.from(track.children) as HTMLElement[];
    const step = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth);
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prevBtn.disabled = track.scrollLeft <= 2;
      nextBtn.disabled = track.scrollLeft >= max;
      const first = Math.round(track.scrollLeft / step());
      const shown = Math.max(1, Math.round(track.clientWidth / step()));
      if (status) status.textContent = `Showing ${first + 1} to ${Math.min(first + shown, items.length)} of ${items.length} projects`;
    };
    prevBtn.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    nextBtn.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    let t: number | undefined;
    track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(update, 80); });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* Full-width colour band; the board inside is as large as possible while the
     whole image still fits between the fixed header and the bottom of the screen.
     Boards are 1400x920 (ratio 1.5217). --hdr is set from the header's real height. */
  .band { background: var(--band); width: 100%; }
  .band + .band { margin-top: 0; }
  .fit-screen { display: block; margin: 0 auto; width: min(100%, calc((100svh - var(--hdr, 4.5rem)) * 1.5217)); }
  .fit-screen img, .pair-item img { display: block; width: 100%; height: auto; }
  .band-pair { display: grid; grid-template-columns: 1fr; gap: 0; padding-top: 0.5rem; }
  .band-pair + .band-pair { padding-top: 0; }
  .pair-item { margin: 0; position: relative; }
  .pair-label {
    position: absolute; top: 0.75rem; left: 1rem; z-index: 1;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: #F7F6F2; background: #1B2A4A; padding: 0.3rem 0.6rem;
  }
  @media (min-width: 768px) { .band-pair { grid-template-columns: 1fr 1fr; } }
  .gallery-open { cursor: zoom-in; }
  .gallery-open { transition: opacity 0.2s; }
  .gallery-open:hover { opacity: 0.94; }
  .gallery-open:focus-visible { outline: 3px solid #C8553D; outline-offset: -3px; }
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(17, 20, 28, 0.94);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox-inner { width: min(94vw, calc((100dvh - 9rem) * 1.5217)); padding: 1rem; display: flex; flex-direction: column; align-items: center; }
  .lightbox-inner img { width: 100%; height: auto; }
  .lightbox-controls { display: flex; gap: 0.75rem; margin-top: 0.75rem; flex-wrap: wrap; justify-content: center; }
  .lb-btn {
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.875rem; font-weight: 600; color: #F7F6F2;
    border: 1px solid rgba(247, 246, 242, 0.45); padding: 0.75rem 1.5rem; min-height: 45px; min-width: 7rem;
    transition: background-color 0.2s, color 0.2s;
  }
  .lb-btn:hover, .lb-btn:focus-visible { background: #F7F6F2; color: #1B2A4A; }

  .others-track {
    display: grid; grid-auto-flow: column; gap: 1.5rem;
    grid-auto-columns: 85%;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    list-style: none; margin: 0; padding: 0;
  }
  .others-track::-webkit-scrollbar { display: none; }
  .others-item { scroll-snap-align: start; display: flex; flex-direction: column; }
  .others-item > :global(*) { flex: 1; }
  @media (min-width: 640px) { .others-track { grid-auto-columns: calc((100% - 1.5rem) / 2); } }
  @media (min-width: 1024px) { .others-track { grid-auto-columns: calc((100% - 3rem) / 3); } }
  .others-btn {
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8125rem; font-weight: 600; color: #1B2A4A;
    border: 1px solid #1B2A4A; background: transparent; padding: 0.6rem 1.1rem; min-height: 45px;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .others-btn:hover:not(:disabled), .others-btn:focus-visible { background: #1B2A4A; color: #F7F6F2; }
  .others-btn:disabled { opacity: 0.35; cursor: default; }

</style>
