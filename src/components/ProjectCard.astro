---
// ProjectCard — renders a single portfolio project entry
interface Props {
  project: {
    id: string;
    name: string;
    blurb: string;
    image: string | null;
    url: string | null;
    category?: string;
    mockupBlurb?: string;
    comingSoon: boolean;
    type?: string;
    location?: string;
    logos?: string[];
    detail: {
      business: string;
      built: string;
      notable: string;
    } | null;
  };
}

const { project } = Astro.props;
const isLogoProject = project.category === 'logo-brand' && project.logos && project.logos.length > 0;
const isMockup = project.category === 'mockup';
const modalId = `logo-modal-${project.id}`;
---

{isLogoProject ? (
  <div class="flex flex-col h-full overflow-hidden bg-white" style="border: 1px solid #E8E6E0;">
    <div class="w-full flex-shrink-0 p-6 bg-white">
      <img src={project.image} alt={`${project.name} logo`} class="w-full object-contain" style="max-height: 180px;" loading="lazy" />
    </div>
    <div class="flex flex-col flex-1 px-5 sm:px-6 pt-5 pb-6">
      <p class="font-body text-[11px] tracking-[0.16em] uppercase text-muted mb-2">Brand identity</p>
      <h3 class="font-serif text-text mb-3" style="font-size: 1.6rem; font-style: italic; font-weight: 400; line-height: 1.1;">{project.name}</h3>
      <p class="font-body text-muted leading-relaxed mb-6 text-[0.95rem]">{project.blurb}</p>
      <button class="logo-modal-trigger mt-auto self-start font-body text-sm font-semibold bg-text text-[#F7F6F2] px-6 py-3 min-h-[45px] hover:bg-muted transition-colors duration-200" data-modal={modalId}>
        View the brand identity
      </button>
    </div>
  </div>
) : project.comingSoon ? (
  <div class="flex flex-col h-full overflow-hidden bg-white" style="border: 1px solid #E8E6E0;">
    <div class="w-full aspect-[16/10] flex items-center justify-center bg-[#F2F1ED]">
      <span class="font-body text-xs tracking-[0.15em] uppercase text-muted">Coming soon</span>
    </div>
    <div class="px-5 sm:px-6 pt-5 pb-6">
      <h3 class="font-serif text-text" style="font-size: 1.6rem; font-style: italic; font-weight: 400;">{project.name}</h3>
    </div>
  </div>
) : (
  <a href={`/portfolio/${project.id}`} class="project-card group flex flex-col h-full focus-visible:outline-2 focus-visible:outline-offset-4">
    <div class="relative w-full overflow-hidden bg-surface" style="border: 1px solid #E8E6E0;">
      {isMockup && (
        <span class="absolute top-3 left-3 z-10 font-body text-[0.625rem] font-semibold tracking-[0.14em] uppercase text-white px-2.5 py-1" style="background: rgba(153,27,27,0.9);">Concept project</span>
      )}
      <img
        src={project.image}
        alt={`Homepage of the ${project.name} website`}
        class="w-full aspect-[16/10] object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        loading="lazy"
        width="1440"
        height="900"
      />
    </div>
    <div class="flex flex-col flex-1 pt-5">
      <p class="font-body text-[11px] tracking-[0.16em] uppercase text-muted mb-2">{project.type ?? 'Website'}{project.location ? ` · ${project.location}` : ''}</p>
      <h3 class="font-serif text-text mb-2" style="font-size: clamp(1.5rem, 2.2vw, 2rem); font-style: italic; font-weight: 400; line-height: 1.1;">{project.name}</h3>
      <p class="font-body text-muted leading-relaxed text-[0.95rem] mb-4">{project.blurb}</p>
      <span class="mt-auto self-start font-body text-sm font-semibold text-text border-b border-text pb-0.5 group-hover:text-coral group-hover:border-coral transition-colors duration-200">View case study<span class="sr-only">: {project.name}</span></span>
    </div>
  </a>
)}

<!-- Logo Modal -->
{isLogoProject && (
  <div
    id={modalId}
    class="logo-modal fixed inset-0 z-50 hidden items-center justify-center p-6"
    style="background: rgba(0,0,0,0.8); backdrop-filter: blur(8px);"
    role="dialog"
    aria-modal="true"
    aria-label={`${project.name} brand identity`}
  >
    <div class="relative bg-white w-full max-w-4xl" style="border-radius: 2px;">
      <!-- Close button -->
      <button
        class="logo-modal-close absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center hover:bg-gray-100 transition-colors duration-200"
        style="border: 1px solid #E8E6E0; background: #fff;"
        aria-label="Close"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1L13 13M13 1L1 13" stroke="#111" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Header -->
      <div class="px-4 sm:px-8 pt-7 pb-5" style="border-bottom: 1px solid #E8E6E0;">
        <p class="font-body text-[10px] tracking-[0.25em] uppercase text-muted mb-1">Brand Identity</p>
        <h2 class="font-display font-bold text-text" style="font-size: 1.2rem;">{project.name}</h2>
      </div>

      <!-- Carousel -->
      <div class="relative px-4 sm:px-8 py-6 sm:py-8">
        <!-- Slide track -->
        <div class="logo-track overflow-hidden">
          <div class="logo-slides flex transition-transform duration-400 ease-in-out">
            {project.logos!.map((logo, i) => (
              <div
                class="logo-slide flex-shrink-0 w-full flex items-center justify-center p-6 sm:p-10"
                style="background: #2C2C2C; min-height: 260px;"
              >
                <img
                  src={logo}
                  alt={`${project.name} logo variant ${i + 1}`}
                  class="object-contain"
                  style="max-height: 280px; max-width: 100%;"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Arrows -->
        <button class="logo-prev absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center bg-white hover:bg-gray-100 transition-colors duration-200 z-10" style="border: 1px solid #E8E6E0;" aria-label="Previous logo">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2L4 7l5 5" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="logo-next absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center bg-white hover:bg-gray-100 transition-colors duration-200 z-10" style="border: 1px solid #E8E6E0;" aria-label="Next logo">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 2l5 5-5 5" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <!-- Dots -->
      <div class="flex items-center justify-center gap-2 pb-6">
        {project.logos!.map((_, i) => (
          <button class="logo-dot w-2 h-2 rounded-full transition-colors duration-200" style={i === 0 ? "background: #111;" : "background: #D5D3CB;"} data-index={i} aria-label={`Go to logo ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  function closeModal(modal: Element) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.documentElement.style.overflow = '';
  }

  // Teleport all modals to document.body so CSS transforms on parents don't break fixed positioning
  document.querySelectorAll('.logo-modal').forEach(modal => {
    document.body.appendChild(modal);
  });

  document.querySelectorAll('.logo-modal').forEach(modal => {
    const slides = modal.querySelectorAll('.logo-slide');
    const track = modal.querySelector('.logo-slides') as HTMLElement | null;
    const dots = modal.querySelectorAll('.logo-dot');
    let current = 0;

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        (d as HTMLElement).style.background = i === current ? '#111' : '#D5D3CB';
      });
    }

    modal.querySelector('.logo-prev')?.addEventListener('click', () => goTo(current - 1));
    modal.querySelector('.logo-next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    modal.querySelector('.logo-modal-close')?.addEventListener('click', () => closeModal(modal));
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(modal); });
  });

  document.querySelectorAll('.logo-modal-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-modal');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (!modal) return;
      const track = modal.querySelector('.logo-slides') as HTMLElement | null;
      if (track) track.style.transform = 'translateX(0)';
      modal.querySelectorAll('.logo-dot').forEach((d, i) => {
        (d as HTMLElement).style.background = i === 0 ? '#111' : '#D5D3CB';
      });
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.documentElement.style.overflow = 'hidden';
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.logo-modal:not(.hidden)').forEach(modal => closeModal(modal));
  });
</script>
