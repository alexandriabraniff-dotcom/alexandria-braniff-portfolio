---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];
---

<footer style="background: #1B2A4A;">

  <!-- Main body -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-10">

    <!-- Centered logo -->
    <div class="flex flex-col items-center text-center mb-12">
      <a href="/" aria-label="Alexandria Braniff - Home" class="hover:opacity-80 transition-opacity duration-200 mb-5">
        <img src="/images/ab-logo.png" alt="Alexandria Braniff" class="h-24 w-24 object-contain" style="filter: brightness(0) invert(1);" />
      </a>
      <p class="font-display font-bold text-lg tracking-tight mb-2" style="color: #F7F6F2;">Alexandria Braniff</p>
      <p class="font-body text-xs" style="color: rgba(247,246,242,0.45);">
        Website designed by Alexandria Braniff
      </p>
    </div>

    <!-- Nav links centered -->
    <nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10" aria-label="Footer navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-body text-sm transition-colors duration-200"
          style="color: rgba(247,246,242,0.6);"
          onmouseover="this.style.color='#F7F6F2'"
          onmouseout="this.style.color='rgba(247,246,242,0.6)'"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Divider -->
    <div class="border-t mb-8" style="border-color: rgba(247,246,242,0.1);"></div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

      <p class="font-body text-xs" style="color: rgba(247,246,242,0.3);">
        &copy; 2026 Alexandria Braniff. All rights reserved. &nbsp;·&nbsp; Vancouver, BC &mdash; Adelaide, SA
      </p>

      <div class="flex items-center gap-4">
        <a
          href="mailto:hello@alexandriabraniff.com"
          class="font-body text-xs transition-colors duration-200"
          style="color: rgba(247,246,242,0.4);"
          onmouseover="this.style.color='#F7F6F2'"
          onmouseout="this.style.color='rgba(247,246,242,0.4)'"
        >
          hello@alexandriabraniff.com
        </a>
        <a
          href="https://www.linkedin.com/in/alexandria-braniff-06b420424"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Alexandria Braniff on LinkedIn"
          class="transition-opacity duration-200 hover:opacity-100"
          style="opacity: 0.45;"
          onmouseover="this.style.opacity='1'"
          onmouseout="this.style.opacity='0.45'"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#F7F6F2" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

</footer>
